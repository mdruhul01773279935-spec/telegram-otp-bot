# Copy to ".env" (next to bot.py - it is loaded automatically) or set these in your hosting dashboard.
# Required:
BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional:
# ADMIN_IDS=123456789,987654321        # users allowed to run /stats
# POLL_INTERVAL=8                      # seconds between inbox checks
# DEFAULT_WATCH_SECONDS=900            # watch duration per number
# EXTEND_SECONDS=600                   # "+10 min" button amount
# MAX_ACTIVE_PER_USER=2                # watchers per user
# LANGS_FILE=langs.json                # per-user language store
# HISTORY_FILE=otp_history.jsonl       # SMS log
# PORT=8080                            # set by web hosts; bot then serves /health
# MAX_NUMBERS_PER_COUNTRY=120          # numbers per country per source
# MAX_PAGES=6                          # listing pages followed
# NUMBERS_PER_PAGE=10
